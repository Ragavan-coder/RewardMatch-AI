# Django Security
DJANGO_SECRET_KEY=change-me-to-a-secure-random-64-character-string
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,proxy,rewardmatch.ai

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rewardmatch
MYSQL_USER=rewardmatch_user
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password

# Redis Broker & Celery Tasks
CELERY_BROKER_URL=redis://:change-me-redis-pass@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-redis-pass@localhost:6379/0
REDIS_PASSWORD=change-me-redis-pass

# CORS & Network Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,https://rewardmatch.ai

# AI & RAG Configuration
LLM_PROVIDER=rules-only
LLM_API_KEY=optional-llm-provider-api-key
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Field Encryption
FIELD_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-or-base64-key

# Email & Alert Delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=change-me-sendgrid-or-ses-key
DEFAULT_FROM_EMAIL=alerts@rewardmatch.ai

# Superuser Initialization
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@rewardmatch.ai
DJANGO_SUPERUSER_PASSWORD=Admin@SecureFintech2026!

# Frontend Build Parameters
VITE_API_BASE_URL=http://127.0.0.1:8000
