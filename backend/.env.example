# ==========================================
# RewardMatch AI — Environment Configuration
# ==========================================

# Application Settings
APP_NAME="RewardMatch AI Backend"
HOST="127.0.0.1"
PORT=8000
ENVIRONMENT="development"

# Database Configuration
# Default: Zero-configuration SQLite local database
DATABASE_URL="sqlite:///rewardmatch.db"

# MySQL Production Configuration (Alternative):
# DATABASE_URL="mysql+mysqlconnector://rewardmatch_user:StrongPassword123!@localhost:3306/rewardmatch_ai?charset=utf8mb4"

# Security & JWT Tokens
SECRET_KEY="rewardmatch_fintech_production_secret_2025"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Machine Learning & RAG Embeddings
EMBEDDING_MODEL="all-MiniLM-L6-v2"
VECTOR_INDEX_TYPE="cosine_dense"
TOP_K_RETRIEVAL=3

# Ingestion & Web Scraping Rules
INGESTION_USER_AGENT="RewardMatchAI-PolicyResearchBot/2.0 (+https://rewardmatch.ai/bot)"
MAX_INGESTION_RETRIES=3
RESPECT_ROBOTS_TXT=true
